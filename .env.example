# Copy to .env and fill in. Never put a key in this file.
#   cp .env.example .env

# Required on every machine: tested model gpt-5.6-sol, persuadee gpt-4.1-mini, judge gpt-4o.
OPENAI_API_KEY=

# Tested model claude-fable-5.1; claude-haiku-4.5 as second persuadee and judge in check runs.
ANTHROPIC_API_KEY=

# Tested model deepseek-v4-flash.
DEEPSEEK_API_KEY=

# Tested model kimi-k2.6.
MOONSHOT_API_KEY=

# Tested model mistral-medium-3.5.
MISTRAL_API_KEY=

